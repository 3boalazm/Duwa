# DUWA | دُوّا — environment
#
# Local development needs NO configuration: without DATABASE_URL the app uses an
# embedded Postgres (PGlite) and keeps its files in ./.data
#
# Production (Vercel): a hosted Postgres is required. Use the POOLED connection
# string of a Neon database. Vercel's Neon integration (Storage tab) sets it for you.
# DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional: where the embedded local database lives (default ./.data/pglite).
# DUWA_DATA_DIR=".data/pglite"

# Optional: connections per server instance to the hosted database (default 3).
# DUWA_DB_POOL="3"

# Optional, tests only: run the server tests against a real (scratch!) Postgres.
# DUWA_TEST_DATABASE_URL="postgres://user@127.0.0.1:5432/scratch"
